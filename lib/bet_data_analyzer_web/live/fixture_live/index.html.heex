<Layouts.app flash={@flash} current_scope={%{}}>
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold">Jogos</h1>
        <p class="text-sm opacity-70">Próximos 7 dias das ligas selecionadas</p>
      </div>
      <button phx-click="sync" class="btn btn-primary btn-sm">
        <.icon name="hero-arrow-path" class="size-4" /> Sincronizar
      </button>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <.form for={%{}} as={:search} phx-change="search" class="flex-1">
        <input
          type="search"
          name="search[q]"
          value={@search}
          placeholder="Buscar time ou jogo..."
          class="input input-bordered w-full"
        />
      </.form>

      <select
        class="select select-bordered"
        phx-change="filter_league"
        name="league_id"
      >
        <option value="">Todas as ligas</option>
        <%= for league <- @leagues do %>
          <option value={league.sportmonks_id} selected={@league_filter == league.sportmonks_id}>
            {league.name}
          </option>
        <% end %>
      </select>
    </div>

    <%= if @fixtures == [] do %>
      <div class="alert">
        <.icon name="hero-information-circle" class="size-5" />
        <span>
          Nenhum jogo encontrado. Configure ligas em
          <.link navigate={~p"/settings"} class="link">Configurações</.link>
          e clique em Sincronizar.
        </span>
      </div>
    <% else %>
      <div class="overflow-x-auto rounded-box border border-base-300">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Data</th>
              <th>Jogo</th>
              <th>Liga</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <%= for fixture <- @fixtures do %>
              <tr>
                <td class="whitespace-nowrap text-sm">
                  {format_kickoff(fixture.starting_at)}
                </td>
                <td>
                  <div class="font-medium">{fixture.name}</div>
                  <div class="text-xs opacity-60">
                    {fixture.home_team_name} vs {fixture.away_team_name}
                  </div>
                </td>
                <td class="text-sm">{fixture.league_name}</td>
                <td>
                  <.fixture_badge status={pack_status(fixture)} />
                </td>
                <td class="text-right">
                  <.link navigate={~p"/fixtures/#{fixture.id}"} class="btn btn-ghost btn-xs">
                    Abrir
                  </.link>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</Layouts.app>